# ─── ŞikayetETKKTC Backend — .env.example ───────────────────
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# Veritabanı (Supabase'den alın)
DATABASE_URL=postgresql+asyncpg://postgres:ŞİFRE@HOST:5432/postgres

# JWT
SECRET_KEY=en-az-32-karakter-rastgele-bir-şey-yazın
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (Frontend domain'leriniz)
CORS_ORIGINS=https://sikayetetkktc.com,https://www.sikayetetkktc.com,http://localhost:5173

# E-posta (Resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@sikayetetkktc.com

# Dosya depolama (Cloudflare R2)
R2_ACCOUNT_ID=xxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxx
R2_BUCKET_NAME=sikayetetkktc-uploads
R2_PUBLIC_URL=https://files.sikayetetkktc.com

# Ortam
ENVIRONMENT=production
DEBUG=false
